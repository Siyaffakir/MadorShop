# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (CORS), or *
CLIENT_ORIGIN=*

# MySQL Database Configuration
# You can provide a full DATABASE_URL or individual MYSQL_* variables:
DATABASE_URL=mysql://root:@localhost:3306/dz_shop

# Optional individual MySQL connection parameters (used if DATABASE_URL is not provided):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=dz_shop

# JWT Configuration
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters — the server refuses to start otherwise.
JWT_SECRET=replace_with_a_long_random_generated_secret_min_32_chars
JWT_EXPIRES_IN=24h

# API Key Configuration
# Shared secret the frontend must send as the X-API-Key header on every /api request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match VITE_API_KEY in frontend/.env exactly. Must be at least 16 characters.
API_KEY=replace_with_a_long_random_generated_key_min_16_chars

# UploadThing Configuration (Cloud Image Bucket)
# Obtain from https://uploadthing.com dashboard -> API Keys
UPLOADTHING_TOKEN=your_uploadthing_token_here

# Default initial admin credentials (used only to seed if database has 0 admins)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123456
